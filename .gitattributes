# 统一换行，避免跨平台 diffs 噪音
* text=auto

# Windows 脚本保持 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.psm1  text eol=crlf

# Unix 脚本保持 LF（否则 bash 会报 \r 错误）
*.sh    text eol=lf
*.bash  text eol=lf

# 二进制
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.zip   binary
*.exe   binary
*.dll   binary

# 语言统计（可选，避免文档被算成代码）
*.md    linguist-documentation
assets/* linguist-documentation